            <a href="https://docs.poppdf.org/build/fonts" class="doc-link">Fonts in the docs &rarr;</a>
        </div>
<?php
$codeFile = 'fonts.php';
$code     = <<<'HTML'
<span class="tok-kw">use</span> <span class="tok-type">Pop\Pdf\Pdf</span>;
