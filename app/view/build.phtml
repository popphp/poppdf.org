<span class="tok-var">$page</span> = <span class="tok-var">$document</span>-&gt;<span class="tok-fn">createPage</span>(<span class="tok-type">Page</span>::<span class="tok-fn">LETTER</span>);

<span class="tok-com">// standard — no font file needed
</span><span class="tok-var">$document</span>-&gt;<span class="tok-fn">addFont</span>(<span class="tok-type">Font</span>::<span class="tok-fn">HELVETICA_BOLD</span>);

